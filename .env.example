# LENS environment configuration
# Copy to .env.local for local development. Never commit real values.

# --- Report persistence (optional but recommended) ---------------------------------
# Cloudflare KV is used as the report store when configured. Create a KV namespace
# and a scoped API token (Workers KV Storage: Edit) for the account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LENS_KV_NAMESPACE_ID=

# Public base URL used for share links and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Browser used for lab measurements and screenshots -----------------------------
# Optional. When empty, LENS resolves a bundled Chromium automatically.
CHROME_PATH=

# --- Optional enrichments ----------------------------------------------------------
# Google PageSpeed Insights API key. When present, LENS additionally queries
# Lighthouse + Chrome UX Report field data for the analysed URL.
PAGESPEED_API_KEY=
